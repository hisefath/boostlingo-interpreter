# Copy to .env and fill in. Never commit .env.
# Required: OpenAI powers voice-to-voice mode and is the default for every cascade stage.
OPENAI_API_KEY=

# Optional second vendors (free tiers). Leave blank to fall back to OpenAI for that stage.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs default voice id (public, not a secret). Free plans cannot use library voices via the API; this default works.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Which vendor each cascade stage uses: openai | deepgram (stt) · openai (translate) · openai | elevenlabs (tts)
STT_PROVIDER=deepgram
TRANSLATE_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# Models (change without code edits)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TRANSLATE_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Local server
PORT=8787
