diff --git a/tests/client/lib.test.ts b/tests/client/lib.test.ts
new file mode 100644
index 0000000..29544e9
--- /dev/null
+++ b/tests/client/lib.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, it } from "vitest";
+import {
+  clockOffset,
+  encodeWav,
+  floatToPcm16,
+  guessLang,
+  parseAudioFrame,
+  pcm16ToFloat,
+  resample,
+  summarizeTimings,
+} from "../../src/client/lib.ts";
+
+describe("guessLang", () => {
+  it("detects Spanish by accents and stopwords", () => {
+    expect(guessLang("¿Dónde le duele?")).toBe("es");
+    expect(guessLang("tengo dolor en el pecho")).toBe("es");
+  });
+  it("detects English", () => {
+    expect(guessLang("Where does it hurt?")).toBe("en");
+    expect(guessLang("I have chest pain")).toBe("en");
+  });
+  it("falls back for empty text", () => {
+    expect(guessLang("", "es")).toBe("es");
+    expect(guessLang("   ")).toBe("en");
+  });
+});
+
+describe("clockOffset", () => {
+  it("maps server time to browser time assuming a symmetric round trip", () => {
+    // sent at 100, server stamped 5050, received at 120 -> server was at 5050 when browser was at 110
+    const off = clockOffset(100, 5050, 120);
+    expect(off).toBe(4940);
+    expect(5050 - off).toBe(110);
+  });
+});
+
+describe("summarizeTimings", () => {
+  it("computes totals and cascade stage bars from speech end", () => {
+    const s = summarizeTimings(
+      {
+        speech_end: 1000,
+        turn_detected: 1200,
+        stt_final: 1300,
+        first_translation: 1500,
+        first_tts_byte: 1800,
+        first_audio: 1900,
+        audio_end: 3900,
+      },
+      "cascade",
+    );
+    expect(s.toFirstAudio).toBe(900);
+    expect(s.toEnd).toBe(2900);
+    expect(s.stages.map((x) => x.ms)).toEqual([200, 100, 200, 300, 100]);
+  });
+  it("marks stages not observable in voice-to-voice mode", () => {
+    const s = summarizeTimings({ speech_end: 1000, turn_detected: 1100, first_audio: 1700 }, "realtime");
+    expect(s.toFirstAudio).toBe(700);
+    expect(s.toEnd).toBeNull();
+    expect(s.stages.every((x) => x.ms === null && !x.observable)).toBe(true);
+  });
+  it("returns null for missing or out-of-order points", () => {
+    const s = summarizeTimings({ first_audio: 1900 }, "cascade");
+    expect(s.toFirstAudio).toBeNull();
+    expect(summarizeTimings({ speech_end: 2000, first_audio: 1900 }, "cascade").toFirstAudio).toBeNull();
+  });
+});
+
+describe("PCM conversion", () => {
+  it("clamps and scales float to PCM16", () => {
+    expect(Array.from(floatToPcm16(new Float32Array([0, 1, -1, 2, -2, 0.5])))).toEqual([
+      0, 32767, -32768, 32767, -32768, 16384,
+    ]);
+  });
+  it("round-trips PCM16 to float", () => {
+    const f = pcm16ToFloat(new Int16Array([0, 16384, -32768]));
+    expect(Array.from(f)).toEqual([0, 0.5, -1]);
+  });
+  it("resamples 48 kHz to 16 kHz with exact length and preserved shape", () => {
+    const input = new Float32Array(960).map((_, i) => i / 960);
+    const out = resample(input, 48000, 16000);
+    expect(out.length).toBe(320);
+    expect(out[0]).toBe(0);
+    expect(out[100]).toBeCloseTo(300 / 960, 5);
+  });
+  it("resamples 44.1 kHz 20 ms blocks to 320 samples and passes equal rates through", () => {
+    expect(resample(new Float32Array(882), 44100, 16000).length).toBe(320);
+    const same = new Float32Array([1, 2, 3]);
+    expect(resample(same, 16000, 16000)).toBe(same);
+  });
+});
+
+describe("parseAudioFrame", () => {
+  it("reads a big-endian 4-byte seq then PCM16 little-endian samples", () => {
+    const buf = new ArrayBuffer(8);
+    const dv = new DataView(buf);
+    dv.setUint32(0, 258, false);
+    dv.setInt16(4, 1000, true);
+    dv.setInt16(6, -2, true);
+    const { seq, pcm } = parseAudioFrame(buf);
+    expect(seq).toBe(258);
+    expect(Array.from(pcm)).toEqual([1000, -2]);
+  });
+});
+
+describe("encodeWav", () => {
+  it("writes a 44-byte RIFF header and PCM16 data", () => {
+    const wav = encodeWav(new Int16Array([1, -1]), 24000);
+    const dv = new DataView(wav.buffer);
+    expect(wav.length).toBe(48);
+    expect(String.fromCharCode(...wav.slice(0, 4))).toBe("RIFF");
+    expect(String.fromCharCode(...wav.slice(8, 12))).toBe("WAVE");
+    expect(dv.getUint32(24, true)).toBe(24000);
+    expect(dv.getUint32(40, true)).toBe(4);
+    expect(dv.getInt16(44, true)).toBe(1);
+    expect(dv.getInt16(46, true)).toBe(-1);
+  });
+});
diff --git a/tests/eval/metrics.test.ts b/tests/eval/metrics.test.ts
new file mode 100644
index 0000000..c5c2de7
--- /dev/null
+++ b/tests/eval/metrics.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from "vitest";
+import {
+  chrF,
+  criticalTermHits,
+  normalise,
+  pcm16ToWav,
+  percentile,
+  realtimeCallCost,
+  resample,
+  wavDurationSec,
+  wer,
+} from "../../scripts/eval/metrics.ts";
+
+describe("normalise", () => {
+  it("lowercases, strips punctuation, keeps accents and digits", () => {
+    expect(normalise("  ¿Usted, qué me RECOMIENDA?  Tome 20 mg. ")).toBe(
+      "usted qué me recomienda tome 20 mg",
+    );
+  });
+  it("empty in, empty out", () => {
+    expect(normalise("")).toBe("");
+  });
+});
+
+describe("wer", () => {
+  it("is 0 for identical text after normalisation", () => {
+    expect(wer("Hello, world!", "hello world")).toBe(0);
+  });
+  it("counts substitution, deletion and insertion over reference length", () => {
+    expect(wer("a b c d", "a x c d")).toBe(0.25); // 1 sub
+    expect(wer("a b c d", "a c d")).toBe(0.25); // 1 del
+    expect(wer("a b c d", "a b c d e")).toBe(0.25); // 1 ins
+    expect(wer("a b", "")).toBe(1);
+  });
+  it("empty reference: 0 when hypothesis empty, insertions counted otherwise", () => {
+    expect(wer("", "")).toBe(0);
+    expect(wer("", "x y")).toBe(2);
+  });
+});
+
+describe("chrF", () => {
+  it("is 100 for identical strings and 0 for disjoint ones", () => {
+    expect(chrF("Take twenty milligrams", "Take twenty milligrams")).toBeCloseTo(100);
+    expect(chrF("abc", "xyz")).toBe(0);
+  });
+  it("ignores whitespace and drops with partial overlap", () => {
+    expect(chrF("ab cd", "abcd")).toBeCloseTo(100);
+    const s = chrF("take twenty milligrams twice a day", "take twenty milligrams once a day");
+    expect(s).toBeGreaterThan(40);
+    expect(s).toBeLessThan(100);
+  });
+  it("empty hypothesis or reference scores 0", () => {
+    expect(chrF("", "abc")).toBe(0);
+    expect(chrF("abc", "")).toBe(0);
+  });
+});
+
+describe("percentile", () => {
+  it("interpolates linearly between ranks", () => {
+    expect(percentile([1, 2, 3, 4], 50)).toBe(2.5);
+    expect(percentile([10, 20, 30, 40, 50], 95)).toBeCloseTo(48);
+    expect(percentile([5, 1, 3], 0)).toBe(1);
+    expect(percentile([5, 1, 3], 100)).toBe(5);
+  });
+  it("single value and empty input", () => {
+    expect(percentile([7], 95)).toBe(7);
+    expect(percentile([], 50)).toBeNaN();
+  });
+});
+
+describe("criticalTermHits", () => {
+  it("matches whole normalised terms only", () => {
+    const r = criticalTermHits(
+      ["20 milligrams", "no aspirin", "March 3"],
+      "Take 20 milligrams twice a day, no aspirin.",
+    );
+    expect(r).toEqual({ hits: 2, total: 3, missing: ["March 3"] });
+  });
+  it("does not match inside a longer number", () => {
+    expect(criticalTermHits(["3"], "March 13").hits).toBe(0);
+  });
+  it("no terms = nothing to miss", () => {
+    expect(criticalTermHits([], "anything")).toEqual({ hits: 0, total: 0, missing: [] });
+  });
+});
+
+describe("realtimeCallCost", () => {
+  const p = { audioInPer1M: 32, audioOutPer1M: 64, cachedInPer1M: 0.4, transcribePerMin: 0.006 };
+  it("1 minute: no prior context to re-bill", () => {
+    // (600*32 + 1200*1*64)/1e6 + 0.006 = 0.0192 + 0.0768 + 0.006
+    expect(realtimeCallCost(1, 1, p)).toBeCloseTo(0.102, 6);
+  });
+  it("re-bills prior minutes as cached input: M(M-1)/2 * tokens/min", () => {
+    // 5 min: 5*0.102 + 10 * (600+1200)*0.4/1e6
+    expect(realtimeCallCost(5, 1, p)).toBeCloseTo(5 * 0.102 + (10 * 1800 * 0.4) / 1e6, 6);
+    const c21 = realtimeCallCost(21, 1, p);
+    expect(c21).toBeCloseTo(21 * 0.102 + (210 * 1800 * 0.4) / 1e6, 6);
+    expect(c21 / 21).toBeGreaterThan(realtimeCallCost(1, 1, p));
+  });
+  it("output ratio r scales output tokens", () => {
+    expect(realtimeCallCost(1, 0.5, p)).toBeCloseTo(0.0192 + 0.0384 + 0.006, 6);
+  });
+});
+
+describe("wav helpers", () => {
+  it("round-trips duration and resamples 24k to 16k", () => {
+    const pcm = new Int16Array(24000);
+    const down = resample(pcm, 24000, 16000);
+    expect(down.length).toBe(16000);
+    expect(wavDurationSec(pcm16ToWav(down, 16000))).toBeCloseTo(1);
+  });
+});
diff --git a/tests/server/pipeline.test.ts b/tests/server/pipeline.test.ts
new file mode 100644
index 0000000..44a45de
--- /dev/null
+++ b/tests/server/pipeline.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it } from "vitest";
+import { ProviderError } from "../../src/shared/contracts.ts";
+import type { Tts, TurnUpdate } from "../../src/shared/contracts.ts";
+import { createPipeline } from "../../src/server/pipeline.ts";
+import { fakeStt, fakeTranslator, fakeTts } from "../../src/server/providers/fake.ts";
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+function setup(tts: Tts, script: Parameters<typeof fakeTranslator>[0] = {}) {
+  const stt = fakeStt([
+    { text: "One, two.", lang: "en" },
+    { text: "Three.", lang: "en" },
+  ]);
+  const updates: TurnUpdate[] = [];
+  const audio: { seq: number; chunk: number[] }[] = [];
+  const timings: string[] = [];
+  const p = createPipeline({
+    stt,
+    translator: fakeTranslator(script),
+    tts,
+    pair: ["en", "es"],
+    limits: { translateMs: 200, ttsMs: 50 },
+    events: {
+      turn: (u) => updates.push(u),
+      audio: (seq, chunk) => audio.push({ seq, chunk: [...chunk] }),
+      timing: (_id, point) => timings.push(point),
+    },
+  });
+  return { p, updates, audio, timings };
+}
+
+describe("pipeline (unit)", () => {
+  it("speaks segments of a turn in order even when an earlier segment is slower", async () => {
+    const tts: Tts = {
+      name: "slow-first",
+      async *speak(req) {
+        await sleep(req.segmentIdx === 0 ? 30 : 0);
+        yield new Uint8Array([req.segmentIdx]);
+      },
+    };
+    const r = setup(tts, { "One, two.": ["Uno, ", "dos."] });
+    r.p.pushAudio(new Int16Array(160));
+    await sleep(100);
+    expect(r.audio.map((a) => a.chunk[0])).toEqual([0, 1]);
+    expect(r.audio.every((a) => a.seq === 1)).toBe(true);
+    expect(r.updates.at(-1)).toMatchObject({ state: "done", tgtText: "Uno, dos.", seq: 1, mode: "cascade" });
+    expect(r.timings).toEqual(["speech_end", "stt_final", "first_translation", "first_tts_byte"]);
+    r.p.stop();
+  });
+
+  it("a period inside a number split across deltas is not a segment end", async () => {
+    const spoken: string[] = [];
+    const tts: Tts = {
+      name: "rec",
+      async *speak(req) {
+        spoken.push(req.text);
+        yield new Uint8Array([0, 0]);
+      },
+    };
+    const r = setup(tts, { "One, two.": ["Tome 3.", 20, "5 mg."] });
+    r.p.pushAudio(new Int16Array(160));
+    await sleep(80);
+    expect(spoken).toEqual(["Tome 3.5 mg."]);
+    r.p.stop();
+  });
+
+  it("each final is its own turn with an increasing seq", async () => {
+    const r = setup(fakeTts());
+    r.p.pushAudio(new Int16Array(160));
+    r.p.pushAudio(new Int16Array(160));
+    await sleep(50);
+    const done = r.updates.filter((u) => u.state === "done").sort((a, b) => a.seq - b.seq);
+    expect(done.map((u) => [u.seq, u.srcText, u.tgtText])).toEqual([
+      [1, "One, two.", "ONE, TWO."],
+      [2, "Three.", "THREE."],
+    ]);
+    r.p.stop();
+  });
+
+  it("a TTS timeout fails the turn and drops its later audio", async () => {
+    const tts: Tts = {
+      name: "hang",
+      async *speak(_req, signal) {
+        await new Promise((_, rej) => signal.addEventListener("abort", () => rej(new Error("aborted"))));
+        yield new Uint8Array([9]);
+      },
+    };
+    const r = setup(tts);
+    r.p.pushAudio(new Int16Array(160));
+    await sleep(120);
+    expect(r.updates.at(-1)).toMatchObject({ state: "failed", reason: "tts timeout", srcText: "One, two." });
+    expect(r.audio).toHaveLength(0);
+    r.p.stop();
+  });
+
+  it("a second rate limit is not retried again", async () => {
+    const rl = new ProviderError("translate", "rate_limited", "429", 5);
+    const r = setup(fakeTts(), { "One, two.": [rl] });
+    r.p.pushAudio(new Int16Array(160));
+    await sleep(60);
+    expect(r.updates.at(-1)).toMatchObject({ state: "failed", reason: "translate rate_limited" });
+    r.p.stop();
+  });
+
+  it("the translator gets only the last 5 turns as context", async () => {
+    const seen: number[] = [];
+    const ctx = Array.from(
+      { length: 7 },
+      (_, i) => ({ srcText: `s${i}`, tgtText: `t${i}`, from: "en", to: "es" }) as const,
+    );
+    const p = createPipeline({
+      stt: fakeStt([{ text: "Hi.", lang: "en" }]),
+      translator: {
+        name: "ctx",
+        async *translate(req) {
+          seen.push(req.context.length);
+          yield req.context[0].srcText;
+        },
+      },
+      tts: fakeTts(),
+      pair: ["en", "es"],
+      limits: { translateMs: 100, ttsMs: 100 },
+      events: { turn() {}, audio() {}, timing() {} },
+      context: [...ctx],
+    });
+    p.pushAudio(new Int16Array(1));
+    await sleep(20);
+    expect(seen).toEqual([5]);
+    p.stop();
+  });
+});
