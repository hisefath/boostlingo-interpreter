+:root {
+  --bg: #f7f7f5;
+  --fg: #1d1d1b;
+  --muted: #5f5f5a;
+  --card: #ffffff;
+  --line: #d9d9d4;
+  --accent: #1f5fbf;
+  --bar: #6a8fd0;
+  --warn: #a33a1f;
+  color-scheme: light dark;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #161615;
+    --fg: #ececea;
+    --muted: #a4a49e;
+    --card: #20201f;
+    --line: #3a3a37;
+    --accent: #7aa7f0;
+    --bar: #4f74b5;
+    --warn: #f08a6c;
+  }
+}
+* {
+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+  padding: 16px;
+  font:
+    15px/1.45 system-ui,
+    sans-serif;
+  background: var(--bg);
+  color: var(--fg);
+}
+h1 {
+  margin: 0;
+  font-size: 1.4rem;
+}
+h2 {
+  margin: 0 0 8px;
+  font-size: 1rem;
+}
+.muted,
+.hint {
+  color: var(--muted);
+}
+.hint {
+  margin: 4px 0;
+  font-size: 0.9rem;
+}
+.controls {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px 20px;
+  align-items: center;
+  margin-top: 12px;
+}
+fieldset {
+  display: flex;
+  gap: 12px;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 4px 10px 6px;
+}
+button {
+  font: inherit;
+  padding: 6px 14px;
+  border-radius: 6px;
+  border: 1px solid var(--line);
+  background: var(--card);
+  color: var(--fg);
+  cursor: pointer;
+}
+button.primary {
+  background: var(--accent);
+  border-color: var(--accent);
+  color: #fff;
+  min-width: 6rem;
+}
+button:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+#status {
+  min-height: 1.4em;
+  font-weight: 600;
+}
+main {
+  display: grid;
+  grid-template-columns: 1fr 1fr 1fr;
+  gap: 12px;
+}
+@media (max-width: 900px) {
+  main {
+    grid-template-columns: 1fr;
+  }
+}
+.pane {
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 12px;
+  min-width: 0;
+}
+.turns {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.turns li {
+  border-top: 1px solid var(--line);
+  padding-top: 6px;
+  overflow-wrap: anywhere;
+}
+.label {
+  display: block;
+  font-size: 0.8rem;
+  color: var(--muted);
+}
+.state-failed,
+.err {
+  color: var(--warn);
+}
+.state-empty,
+.state-cut {
+  color: var(--muted);
+  font-style: italic;
+}
+.bar-row {
+  display: grid;
+  grid-template-columns: 11rem 1fr 4rem;
+  gap: 6px;
+  align-items: center;
+  font-size: 0.8rem;
+}
+.bar {
+  height: 8px;
+  background: var(--bar);
+  border-radius: 4px;
+}
+.na {
+  color: var(--muted);
+  font-style: italic;
+}
diff --git a/src/client/transports/cascade.ts b/src/client/transports/cascade.ts
new file mode 100644
index 0000000..ddad31f
--- /dev/null
+++ b/src/client/transports/cascade.ts
@@ -0,0 +1,148 @@
+// Cascade transport (lld §3, §5): WebSocket /cascade, mic PCM16 16 kHz up, events + seq-prefixed PCM16 24 kHz down.
+import type { ClientMsg, Lang, ServerMsg, TurnText } from "../../shared/contracts.ts";
+import { capture } from "../capture.ts";
+import { clockOffset, floatToPcm16, parseAudioFrame, resample } from "../lib.ts";
+import { Player } from "../player.ts";
+import type { Transport, TransportEvents } from "../session.ts";
+
+const UP_RATE = 16000;
+
+export class CascadeTransport implements Transport {
+  private ws: WebSocket | null = null;
+  private player: Player | null = null;
+  private stopCapture: (() => void) | null = null;
+  private offset = 0;
+  private bestRtt = Infinity;
+  private pinger: ReturnType<typeof setInterval> | undefined;
+  private stopped = false;
+  private reconnected = false;
+  private echoGuard = true;
+  private seqOf = new Map<string, number>();
+  private idOf = new Map<number, string>();
+  private context: TurnText[] = [];
+  private pair: [Lang, Lang] = ["en", "es"];
+
+  constructor(private ev: TransportEvents) {}
+
+  async start(input: MediaStream, context: TurnText[], pair: [Lang, Lang]): Promise<void> {
+    this.context = context;
+    this.pair = pair;
+    const player = new Player({
+      firstAudio: (seq, t) => this.idOf.has(seq) && this.ev.timing(this.idOf.get(seq)!, "first_audio", t),
+      audioEnd: (seq, t) => this.idOf.has(seq) && this.ev.timing(this.idOf.get(seq)!, "audio_end", t),
+      cut: (seq) => this.idOf.has(seq) && this.ev.turn({ turnId: this.idOf.get(seq)!, state: "cut" }),
+    });
+    this.player = player;
+    await player.ctx.resume();
+    await this.connect();
+    const block = Math.round(player.ctx.sampleRate / 50); // 20 ms
+    let acc: number[] = [];
+    this.stopCapture = await capture(player.ctx, input, (chunk) => {
+      for (const v of chunk) acc.push(v);
+      while (acc.length >= block) {
+        const frame = resample(Float32Array.from(acc.splice(0, block)), player.ctx.sampleRate, UP_RATE);
+        // echo guard: send silence (keeps the STT clock running) while our own audio plays
+        const pcm = this.echoGuard && player.playing ? new Int16Array(frame.length) : floatToPcm16(frame);
+        if (this.ws?.readyState === WebSocket.OPEN) this.ws.send(pcm as Int16Array<ArrayBuffer>);
+      }
+    });
+  }
+
+  stop(): void {
+    this.stopped = true;
+    clearInterval(this.pinger);
+    if (this.ws?.readyState === WebSocket.OPEN) this.send({ type: "stop" });
+    this.ws?.close();
+    this.stopCapture?.();
+    this.player?.close();
+  }
+
+  output(): MediaStream | null {
+    return this.player?.stream ?? null;
+  }
+
+  /** PCM16 24 kHz audio received for a turn (eval recording) */
+  recorded(turnId: string): Int16Array[] {
+    const seq = this.seqOf.get(turnId);
+    return seq === undefined || !this.player ? [] : this.player.recorded(seq);
+  }
+
+  setEchoGuard(on: boolean): void {
+    this.echoGuard = on;
+  }
+
+  private send(m: ClientMsg): void {
+    this.ws?.send(JSON.stringify(m));
+  }
+
+  private connect(): Promise<void> {
+    return new Promise((resolve, reject) => {
+      const ws = new WebSocket(`${location.protocol === "https:" ? "wss" : "ws"}://${location.host}/cascade`);
+      ws.binaryType = "arraybuffer";
+      this.ws = ws;
+      let opened = false;
+      ws.onopen = () => {
+        opened = true;
+        this.send({ type: "start", pair: this.pair, context: this.context });
+        const ping = () => this.send({ type: "ping", t: performance.now() });
+        ping();
+        clearInterval(this.pinger);
+        this.pinger = setInterval(ping, 5000);
+        resolve();
+      };
+      ws.onmessage = (e) =>
+        typeof e.data === "string" ? this.onJson(JSON.parse(e.data)) : this.onAudio(e.data);
+      ws.onclose = () => {
+        clearInterval(this.pinger);
+        if (this.stopped) return;
+        if (!opened) return reject(new Error("could not connect to the cascade server"));
+        if (this.reconnected) return this.ev.error("cascade connection lost");
+        this.reconnected = true;
+        this.ev.notice("cascade connection lost, reconnecting…");
+        this.connect().then(
+          () => this.ev.notice("reconnected"),
+          () => this.ev.error("cascade connection lost; reconnect failed"),
+        );
+      };
+    });
+  }
+
+  private onAudio(buf: ArrayBuffer): void {
+    const { seq, pcm } = parseAudioFrame(buf);
+    this.player?.push(seq, pcm);
+  }
+
+  private onJson(m: ServerMsg): void {
+    const now = performance.now();
+    switch (m.type) {
+      case "pong": {
+        const rtt = now - m.t;
+        if (rtt <= this.bestRtt) {
+          this.bestRtt = rtt;
+          this.offset = clockOffset(m.t, m.serverT, now);
+        }
+        return;
+      }
+      case "turn": {
+        const { type: _type, ...u } = m;
+        this.seqOf.set(u.turnId, u.seq);
+        this.idOf.set(u.seq, u.turnId);
+        this.ev.turn(u);
+        this.player?.setState(u.seq, u.state);
+        return;
+      }
+      case "timing": {
+        this.ev.timing(m.turnId, m.point, m.serverT - this.offset, m.vendor);
+        const seq = this.seqOf.get(m.turnId);
+        // barge-in only with headphones: with the echo guard on, the mic is silent while we play, so a new
+        // speech end then belongs to speech from before playback. ponytail: no per-turn time comparison.
+        const ended = m.point === "speech_end" || m.point === "stt_final";
+        if (seq !== undefined && ended && !this.echoGuard) this.player?.bargeIn(seq);
+        return;
+      }
+      case "error":
+        this.ev.error(`${m.stage} ${m.kind}: ${m.message}`);
+        return;
+    }
+  }
+}
diff --git a/src/client/transports/realtime.ts b/src/client/transports/realtime.ts
new file mode 100644
index 0000000..6ec1e1b
--- /dev/null
+++ b/src/client/transports/realtime.ts
@@ -0,0 +1,196 @@
+// Voice-to-voice transport (lld §5, hld §4): WebRTC straight to OpenAI Realtime with a short-lived client secret
+// minted by our server; events on the "oai-events" data channel become turn updates and timing points.
+import type { Lang, TurnText } from "../../shared/contracts.ts";
+import { guessLang, otherLang } from "../lib.ts";
+import type { Transport, TransportEvents } from "../session.ts";
+
+const CALLS_URL = "https://api.openai.com/v1/realtime/calls?model=gpt-realtime";
+
+// Shape of the data-channel events we read (fields are optional on purpose: we only trust what arrives).
+interface OaiEvent {
+  type: string;
+  item_id?: string;
+  response_id?: string;
+  audio_end_ms?: number;
+  delta?: string;
+  transcript?: string;
+  response?: { id?: string };
+  error?: { message?: string };
+}
+
+export class RealtimeTransport implements Transport {
+  private pc: RTCPeerConnection | null = null;
+  private audio = new Audio();
+  private remote: MediaStream | null = null;
+  private mic: MediaStreamTrack | null = null;
+  private t0 = 0;
+  private echoGuard = true;
+  private stopped = false;
+  private reconnected = false;
+  private seq = 0;
+  private current: string | null = null;
+  private byResponse = new Map<string, string>();
+  private src = new Map<string, string>();
+  private tgt = new Map<string, string>();
+  private input: MediaStream | null = null;
+  private context: TurnText[] = [];
+  private pair: [Lang, Lang] = ["en", "es"];
+
+  constructor(private ev: TransportEvents) {
+    this.audio.autoplay = true;
+  }
+
+  async start(input: MediaStream, context: TurnText[], pair: [Lang, Lang]): Promise<void> {
+    this.input = input;
+    this.context = context;
+    this.pair = pair;
+    await this.connect();
+  }
+
+  stop(): void {
+    this.stopped = true;
+    this.pc?.close();
+    this.mic?.stop();
+    this.audio.srcObject = null;
+  }
+
+  output(): MediaStream | null {
+    return this.remote;
+  }
+
+  setEchoGuard(on: boolean): void {
+    this.echoGuard = on;
+    if (!on && this.mic) this.mic.enabled = true;
+  }
+
+  private async connect(): Promise<void> {
+    const r = await fetch("/api/realtime-session", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ pair: this.pair, context: this.context }),
+    });
+    if (!r.ok) throw new Error(`realtime session failed (${r.status})`);
+    const { value } = (await r.json()) as { value: string; expiresAt: number };
+
+    const pc = new RTCPeerConnection();
+    this.pc = pc;
+    pc.ontrack = (e) => {
+      this.remote = e.streams[0] ?? new MediaStream([e.track]);
+      this.audio.srcObject = this.remote;
+    };
+    this.mic?.stop();
+    const track = this.input!.getAudioTracks()[0];
+    if (!track) throw new Error("no audio input");
+    this.mic = track.clone(); // own copy, so the echo guard can disable it without touching the caller's track
+    pc.addTrack(this.mic);
+    const dc = pc.createDataChannel("oai-events");
+    dc.onopen = () => (this.t0 = performance.now());
+    dc.onmessage = (e) => this.onEvent(JSON.parse(e.data as string) as OaiEvent);
+    pc.onconnectionstatechange = () => {
+      if (this.stopped || pc !== this.pc) return;
+      if (pc.connectionState !== "failed" && pc.connectionState !== "disconnected") return;
+      if (this.reconnected) return this.ev.error("voice-to-voice connection lost");
+      this.reconnected = true;
+      this.ev.notice("voice-to-voice connection lost, reconnecting…");
+      pc.close();
+      this.connect().then(
+        () => this.ev.notice("reconnected"),
+        () => this.ev.error("voice-to-voice connection lost; reconnect failed"),
+      );
+    };
+
+    const offer = await pc.createOffer();
+    await pc.setLocalDescription(offer);
+    const answer = await fetch(CALLS_URL, {
+      method: "POST",
+      body: offer.sdp,
+      headers: { Authorization: `Bearer ${value}`, "Content-Type": "application/sdp" },
+    });
+    if (!answer.ok) throw new Error(`OpenAI realtime call failed (${answer.status})`);
+    await pc.setRemoteDescription({ type: "answer", sdp: await answer.text() });
+  }
+
+  /** the turn an event belongs to; creates one when speech_started was missed */
+  private turnFor(itemId?: string): string {
+    if (itemId && this.src.has(itemId)) return itemId;
+    if (itemId && !this.current) return this.newTurn(itemId);
+    return this.current ?? this.newTurn(itemId ?? `rt-${this.seq}`);
+  }
+
+  private newTurn(id: string): string {
+    this.current = id;
+    this.src.set(id, "");
+    this.tgt.set(id, "");
+    this.ev.turn({
+      turnId: id,
+      seq: this.seq++,
+      mode: "realtime",
+      state: "hearing",
+      from: this.pair[0],
+      to: this.pair[1],
+    });
+    return id;
+  }
+
+  private setSrc(id: string, text: string): void {
+    this.src.set(id, text);
+    const from = guessLang(text, this.pair[0]);
+    this.ev.turn({ turnId: id, srcText: text, from, to: otherLang(this.pair, from) });
+  }
+
+  private onEvent(e: OaiEvent): void {
+    const now = performance.now();
+    switch (e.type) {
+      case "input_audio_buffer.speech_started":
+        this.newTurn(e.item_id ?? `rt-${this.seq}`);
+        return;
+      case "input_audio_buffer.speech_stopped": {
+        const id = this.turnFor(e.item_id);
+        if (e.audio_end_ms !== undefined) this.ev.timing(id, "speech_end", this.t0 + e.audio_end_ms);
+        this.ev.timing(id, "turn_detected", now);
+        this.ev.turn({ turnId: id, state: "translating" });
+        return;
+      }
+      case "conversation.item.input_audio_transcription.delta": {
+        const id = this.turnFor(e.item_id);
+        this.setSrc(id, (this.src.get(id) ?? "") + (e.delta ?? ""));
+        return;
+      }
+      case "conversation.item.input_audio_transcription.completed": {
+        const id = this.turnFor(e.item_id);
+        const text = e.transcript ?? this.src.get(id) ?? "";
+        this.setSrc(id, text);
+        if (!text.trim()) this.ev.turn({ turnId: id, state: "empty" });
+        return;
+      }
+      case "response.created":
+        if (e.response?.id) this.byResponse.set(e.response.id, this.turnFor());
+        return;
+      case "response.output_audio_transcript.delta": {
+        const id = this.byResponse.get(e.response_id ?? "") ?? this.turnFor();
+        const text = (this.tgt.get(id) ?? "") + (e.delta ?? "");
+        this.tgt.set(id, text);
+        this.ev.turn({ turnId: id, tgtText: text, state: "speaking" });
+        return;
+      }
+      case "output_audio_buffer.started": {
+        const id = this.byResponse.get(e.response_id ?? "") ?? this.turnFor();
+        this.ev.timing(id, "first_audio", now);
+        if (this.echoGuard && this.mic) this.mic.enabled = false;
+        return;
+      }
+      case "output_audio_buffer.stopped":
+      case "output_audio_buffer.cleared": {
+        const id = this.byResponse.get(e.response_id ?? "") ?? this.turnFor();
+        if (this.mic) this.mic.enabled = true;
+        if (e.type === "output_audio_buffer.cleared") return this.ev.turn({ turnId: id, state: "cut" });
+        this.ev.timing(id, "audio_end", now);
+        this.ev.turn({ turnId: id, state: "done" });
+        return;
+      }
+      case "error":
+        this.ev.error(e.error?.message ?? "realtime error", this.current ?? undefined);
+        return;
+    }
+  }
+}
diff --git a/src/server/index.ts b/src/server/index.ts
new file mode 100644
index 0000000..901937c
--- /dev/null
+++ b/src/server/index.ts
@@ -0,0 +1,193 @@
+// Node server: HTTP routes + WS /cascade (lld.md §3–§4). Never logs keys or transcripts.
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { WebSocketServer, type WebSocket } from "ws";
+import type { ClientMsg, Lang, ServerMsg, TurnText } from "../shared/contracts.ts";
+import { createPipeline, type Pipeline } from "./pipeline.ts";
+import { createProviders, type Env } from "./providers/registry.ts";
+import { interpreterInstructions } from "./providers/http.ts";
+
+const LIMITS = { translateMs: 4000, ttsMs: 5000 }; // lld.md §2
+const MAX_BODY = 50 * 1024 * 1024; // eval runs carry base64 WAVs
+const SAFE_ID = /^[A-Za-z0-9_-]{1,100}$/;
+const LANGS: Lang[] = ["en", "es"];
+
+export interface AppOptions {
+  env?: Env;
+  /** folder holding clips.json, clips/ and results/ */
+  evalDir?: string;
+}
+
+function send(res: ServerResponse, status: number, body: unknown) {
+  res.writeHead(status, { "content-type": "application/json" });
+  res.end(JSON.stringify(body));
+}
+
+async function readBody(req: IncomingMessage): Promise<string> {
+  let size = 0;
+  const parts: Buffer[] = [];
+  for await (const c of req as AsyncIterable<Buffer>) {
+    size += c.length;
+    if (size > MAX_BODY) throw new Error("body too large");
+    parts.push(c);
+  }
+  return Buffer.concat(parts).toString("utf8");
+}
+
+const isPair = (p: unknown): p is [Lang, Lang] =>
+  Array.isArray(p) && p.length === 2 && p.every((l) => LANGS.includes(l)) && p[0] !== p[1];
+const asContext = (c: unknown): TurnText[] => (Array.isArray(c) ? (c as TurnText[]).slice(-5) : []);
+
+async function realtimeSession(env: Env, body: { pair?: unknown; context?: unknown }) {
+  const pair = isPair(body.pair) ? body.pair : (["en", "es"] as [Lang, Lang]);
+  const ctx = asContext(body.context);
+  let instructions = interpreterInstructions(pair[0], pair[1]);
+  if (ctx.length) {
+    instructions +=
+      "\n\nRecent conversation, for context only (do not repeat it):\n" +
+      ctx.map((t) => `${t.from}: ${t.srcText} -> ${t.to}: ${t.tgtText}`).join("\n");
+  }
+  const res = await fetch("https://api.openai.com/v1/realtime/client_secrets", {
+    method: "POST",
+    headers: { authorization: `Bearer ${env.OPENAI_API_KEY ?? ""}`, "content-type": "application/json" },
+    body: JSON.stringify({
+      expires_after: { anchor: "created_at", seconds: 600 },
+      session: {
+        type: "realtime",
+        model: env.OPENAI_REALTIME_MODEL || "gpt-realtime",
+        instructions,
+        audio: {
+          input: {
+            transcription: { model: env.OPENAI_STT_MODEL || "gpt-4o-transcribe" },
+            turn_detection: { type: "server_vad" },
+          },
+        },
+      },
+    }),
+  });
+  if (!res.ok) return { status: 502, body: { error: `client secret mint failed (HTTP ${res.status})` } };
+  const j = (await res.json()) as { value: string; expires_at: number };
+  return { status: 200, body: { value: j.value, expiresAt: j.expires_at } };
+}
+
+export function createAppServer(opts: AppOptions = {}): Server {
+  const env = opts.env ?? process.env;
+  const evalDir = resolve(opts.evalDir ?? "eval");
+
+  const server = createServer(async (req, res) => {
+    const url = new URL(req.url ?? "/", "http://localhost");
+    try {
+      if (req.method === "GET" && url.pathname === "/api/config") {
+        const p = createProviders(env);
+        return send(res, 200, {
+          stt: p.stt.name,
+          translate: p.translator.name,
+          tts: p.tts.name,
+          realtime: env.OPENAI_REALTIME_MODEL || "gpt-realtime",
+        });
+      }
+      if (req.method === "POST" && url.pathname === "/api/realtime-session") {
+        const r = await realtimeSession(env, JSON.parse((await readBody(req)) || "{}"));
+        return send(res, r.status, r.body);
+      }
+      if (req.method === "GET" && url.pathname === "/api/eval-clips") {
+        try {
+          return send(res, 200, JSON.parse(await readFile(join(evalDir, "clips.json"), "utf8")));
+        } catch {
+          return send(res, 200, []);
+        }
+      }
+      const clip = url.pathname.match(/^\/eval\/clips\/([^/]+)\.wav$/);
+      if (req.method === "GET" && clip) {
+        const id = decodeURIComponent(clip[1]);
+        if (!SAFE_ID.test(id)) return send(res, 404, { error: "not found" });
+        try {
+          const wav = await readFile(join(evalDir, "clips", `${id}.wav`));
+          res.writeHead(200, { "content-type": "audio/wav" });
+          return res.end(wav);
+        } catch {
+          return send(res, 404, { error: "not found" });
+        }
+      }
+      if (req.method === "POST" && url.pathname === "/api/eval-results") {
+        const run = JSON.parse(await readBody(req)) as { runId?: unknown };
+        if (typeof run.runId !== "string" || !SAFE_ID.test(run.runId))
+          return send(res, 400, { error: "bad runId" });
+        await mkdir(join(evalDir, "results"), { recursive: true });
+        await writeFile(join(evalDir, "results", `${run.runId}.json`), JSON.stringify(run, null, 2));
+        return send(res, 200, { ok: true });
+      }
+      send(res, 404, { error: "not found" });
+    } catch (e) {
+      send(res, e instanceof SyntaxError ? 400 : 500, {
+        error: e instanceof SyntaxError ? "bad json" : "server error",
+      });
+    }
+  });
+
+  const wss = new WebSocketServer({ server, path: "/cascade" });
+  wss.on("connection", (ws: WebSocket) => {
+    let pipeline: Pipeline | null = null;
+    const out = (m: ServerMsg) => {
+      if (ws.readyState === ws.OPEN) ws.send(JSON.stringify(m));
+    };
+    const stop = () => {
+      pipeline?.stop();
+      pipeline = null;
+    };
+
+    ws.on("message", (data, isBinary) => {
+      if (isBinary) {
+        const buf = data as Buffer;
+        // Copy into an aligned buffer: Buffer slices may start at an odd offset.
+        const pcm = new Int16Array(Math.floor(buf.length / 2));
+        new Uint8Array(pcm.buffer).set(buf.subarray(0, pcm.length * 2));
+        pipeline?.pushAudio(pcm);
+        return;
+      }
+      let msg: ClientMsg;
+      try {
+        msg = JSON.parse(data.toString());
+      } catch {
+        return out({ type: "error", stage: "session", kind: "failed", message: "bad json" });
+      }
+      if (msg.type === "ping") return out({ type: "pong", t: msg.t, serverT: Date.now() });
+      if (msg.type === "stop") return stop();
+      if (msg.type === "start") {
+        stop();
+        if (!isPair(msg.pair))
+          return out({ type: "error", stage: "session", kind: "failed", message: "bad pair" });
+        const p = createProviders(env);
+        pipeline = createPipeline({
+          ...p,
+          pair: msg.pair,
+          limits: LIMITS,
+          context: asContext(msg.context),
+          events: {
+            turn: (u) => out({ type: "turn", ...u }),
+            timing: (turnId, point, serverT, vendor) =>
+              out({ type: "timing", turnId, point, serverT, vendor }),
+            audio: (seq, chunk) => {
+              if (ws.readyState !== ws.OPEN) return;
+              const frame = Buffer.alloc(4 + chunk.length);
+              frame.writeUInt32BE(seq, 0);
+              frame.set(chunk, 4);
+              ws.send(frame);
+            },
+            error: (e) => out({ type: "error", stage: e.stage, kind: e.kind, message: e.message }),
+          },
+        });
+      }
+    });
+    ws.on("close", stop);
+  });
+
+  return server;
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const port = Number(process.env.PORT) || 8787;
+  createAppServer().listen(port, () => console.log(`server listening on :${port}`));
+}
diff --git a/src/server/pipeline.ts b/src/server/pipeline.ts
new file mode 100644
index 0000000..2433760
--- /dev/null
+++ b/src/server/pipeline.ts
@@ -0,0 +1,217 @@
+// Cascade pipeline: STT finals -> streamed translation -> settled segments -> TTS (lld.md §1–§2, hld.md INV-3/5/6).
+import { ProviderError } from "../shared/contracts.ts";
+import type {
+  Lang,
+  SttFinal,
+  SttProvider,
+  Stage,
+  TimingPoint,
+  Translator,
+  Tts,
+  TurnState,
+  TurnText,
+  TurnUpdate,
+} from "../shared/contracts.ts";
+
+export interface PipelineEvents {
+  turn(u: TurnUpdate): void;
+  audio(seq: number, chunk: Uint8Array): void;
+  timing(turnId: string, point: TimingPoint, serverT: number, vendor?: string): void;
+  error?(e: ProviderError): void;
+}
+
+export interface PipelineOptions {
+  stt: SttProvider;
+  translator: Translator;
+  tts: Tts;
+  pair: [Lang, Lang];
+  limits: { translateMs: number; ttsMs: number };
+  events: PipelineEvents;
+  context?: TurnText[];
+}
+
+export interface Pipeline {
+  pushAudio(pcm: Int16Array): void;
+  setContext(ctx: TurnText[]): void;
+  stop(): void;
+}
+
+const CONTEXT_TURNS = 5;
+/** A clause/sentence end followed by whitespace: everything up to it is settled (FR-025). */
+const BOUNDARY = /[,.?!;:](?=\s)/g;
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+export function createPipeline(o: PipelineOptions): Pipeline {
+  let context = [...(o.context ?? [])];
+  let seq = 0;
+  let stopped = false;
+  const live = new Set<AbortController>();
+  const other = (l: Lang): Lang => (l === o.pair[0] ? o.pair[1] : o.pair[0]);
+
+  const stream = o.stt.open({
+    languages: [...o.pair],
+    onPartial(p) {
+      if (stopped) return;
+      const n = seq + 1;
+      o.events.turn({
+        turnId: `t${n}`,
+        seq: n,
+        mode: "cascade",
+        state: "hearing",
+        from: p.lang,
+        to: other(p.lang),
+        srcText: p.text,
+      });
+    },
+    onFinal(f) {
+      if (!stopped) void runTurn(f);
+    },
+    onError(e) {
+      o.events.error?.(e);
+    },
+  });
+
+  async function runTurn(f: SttFinal) {
+    const n = ++seq;
+    const turnId = `t${n}`;
+    const from = f.lang;
+    const to = other(from);
+    const srcText = f.text.trim();
+    const mine = new Set<AbortController>();
+    let dead = false; // failed or finished: every later result for this turn is dropped (INV-3)
+    let state: TurnState = "translating";
+    let tgt = "";
+
+    const emit = (s: TurnState, extra: Partial<TurnUpdate> = {}) => {
+      if (dead || stopped) return;
+      state = s;
+      o.events.turn({ turnId, seq: n, mode: "cascade", state: s, from, to, srcText, ...extra });
+    };
+    const fail = (e: unknown, st: Stage) => {
+      if (dead) return;
+      const reason = e instanceof ProviderError ? `${e.stage} ${e.kind}` : `${st} failed`;
+      emit("failed", { reason, tgtText: tgt.trim() || undefined });
+      dead = true;
+      for (const ac of mine) ac.abort();
+    };
+    /** Runs one stage call with its own AbortController and timeout; the race fires even if fn ignores the signal. */
+    const stage = async (st: Stage, ms: number, fn: (signal: AbortSignal) => Promise<void>) => {
+      const ac = new AbortController();
+      mine.add(ac);
+      live.add(ac);
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      const timeout = new Promise<never>((_, rej) => {
+        timer = setTimeout(() => {
+          ac.abort();
+          rej(new ProviderError(st, "timeout"));
+        }, ms);
+      });
+      try {
+        await Promise.race([fn(ac.signal), timeout]);
+      } finally {
+        clearTimeout(timer);
+        mine.delete(ac);
+        live.delete(ac);
+      }
+    };
+
+    o.events.timing(turnId, "speech_end", f.endMs, o.stt.name);
+    o.events.timing(turnId, "stt_final", Date.now(), o.stt.name);
+    if (!srcText) {
+      emit("empty");
+      dead = true;
+      return;
+    }
+    emit("translating");
+
+    // TTS: settled segments are spoken one after another, in order, while translation continues (FR-004).
+    let speaking = Promise.resolve();
+    let segIdx = 0;
+    let firstByte = false;
+    const speak = (text: string) => {
+      const segmentIdx = segIdx++;
+      speaking = speaking.then(async () => {
+        if (dead || stopped) return;
+        try {
+          await stage("tts", o.limits.ttsMs, async (signal) => {
+            for await (const chunk of o.tts.speak({ turnId, segmentIdx, text, lang: to }, signal)) {
+              if (dead || stopped) return;
+              if (!firstByte) {
+                firstByte = true;
+                o.events.timing(turnId, "first_tts_byte", Date.now(), o.tts.name);
+                emit("speaking", { tgtText: tgt.trim() });
+              }
+              o.events.audio(n, chunk);
+            }
+          });
+        } catch (e) {
+          fail(e, "tts");
+        }
+      });
+    };
+
+    let buf = "";
+    const cut = (end: boolean) => {
+      let at = end ? buf.length : -1;
+      if (!end) for (const m of buf.matchAll(BOUNDARY)) at = m.index + 1;
+      if (at <= 0) return;
+      const seg = buf.slice(0, at).trim();
+      buf = buf.slice(at);
+      if (seg) speak(seg);
+    };
+
+    const req = { turnId, text: srcText, from, to, context: context.slice(-CONTEXT_TURNS) };
+    try {
+      for (let attempt = 0; ; attempt++) {
+        try {
+          await stage("translate", o.limits.translateMs, async (signal) => {
+            for await (const delta of o.translator.translate(req, signal)) {
+              if (dead || stopped) return;
+              if (!tgt) o.events.timing(turnId, "first_translation", Date.now(), o.translator.name);
+              tgt += delta;
+              buf += delta;
+              emit(state, { tgtText: tgt.trim() });
+              cut(false);
+            }
+          });
+          break;
+        } catch (e) {
+          // FR-012: one retry after the advised wait, only if nothing was streamed yet.
+          if (e instanceof ProviderError && e.kind === "rate_limited" && attempt === 0 && !tgt && !dead) {
+            await sleep(e.retryAfterMs ?? 1000);
+            continue;
+          }
+          throw e;
+        }
+      }
+      if (dead || stopped) return;
+      cut(true);
+      if (!tgt.trim()) throw new ProviderError("translate", "empty");
+    } catch (e) {
+      fail(e, "translate");
+      return;
+    }
+
+    await speaking;
+    if (dead || stopped) return;
+    emit("done", { tgtText: tgt.trim() });
+    dead = true;
+    context.push({ srcText, tgtText: tgt.trim(), from, to });
+    context = context.slice(-CONTEXT_TURNS);
+  }
+
+  return {
+    pushAudio(pcm) {
+      if (!stopped) stream.push(pcm);
+    },
+    setContext(ctx) {
+      context = [...ctx];
+    },
+    stop() {
+      if (stopped) return;
+      stopped = true;
+      stream.close();
+      for (const ac of live) ac.abort();
+    },
+  };
+}
