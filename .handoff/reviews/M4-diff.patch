+++ b/src/client/main.ts
@@ -0,0 +1,152 @@
+// Workbench UI: controls, transcripts and timing (render only; state lives in Session).
+import type { Lang, Mode } from "../shared/contracts.ts";
+import { runEval } from "./eval.ts";
+import { summarizeTimings } from "./lib.ts";
+import { Session, type Turn } from "./session.ts";
+import { CascadeTransport } from "./transports/cascade.ts";
+import { RealtimeTransport } from "./transports/realtime.ts";
+
+const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const startBtn = $<HTMLButtonElement>("start");
+const evalBtn = $<HTMLButtonElement>("eval");
+const pairSel = $<HTMLSelectElement>("pair");
+const headphones = $<HTMLInputElement>("headphones");
+const statusEl = $("status");
+const LANG: Record<Lang, string> = { en: "English", es: "Spanish" };
+const BAR_SCALE_MS = 3000;
+
+let vendors: Record<string, string> = {};
+let micDenied = false;
+let busy = false;
+const setStatus = (msg: string) => (statusEl.textContent = msg);
+
+const session = new Session(
+  (mode, ev) => (mode === "realtime" ? new RealtimeTransport(ev) : new CascadeTransport(ev)),
+  (notice) => {
+    if (notice) setStatus(notice);
+    render();
+  },
+);
+
+function esc(s: string): string {
+  return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+function targetLine(t: Turn): string {
+  if (t.state === "failed")
+    return `<span class="state-failed">not interpreted (${esc(t.reason ?? "failed")})</span>`;
+  if (t.state === "empty") return `<span class="state-empty">nothing heard</span>`;
+  const text = esc(t.tgtText ?? "");
+  return t.state === "cut" ? `${text} <span class="state-cut">(cut off)</span>` : text || "…";
+}
+
+function timingItem(t: Turn): string {
+  const s = summarizeTimings(t.timings, t.mode);
+  const ms = (v: number | null) => (v === null ? "—" : `${v} ms`);
+  const bars = s.stages
+    .map((b) => {
+      const cell = !b.observable
+        ? `<span class="na">not observable in this mode</span>`
+        : b.ms === null
+          ? `<span class="na">—</span>`
+          : `<div class="bar" style="width:${Math.min(100, (b.ms / BAR_SCALE_MS) * 100)}%"></div>`;
+      return `<div class="bar-row"><span>${b.name}</span>${cell}<span>${b.observable ? ms(b.ms) : ""}</span></div>`;
+    })
+    .join("");
+  return `<li><span class="label">Turn ${t.seq + 1} · ${t.mode === "realtime" ? "voice-to-voice" : "cascade"}</span>
+    To first audio: <strong>${ms(s.toFirstAudio)}</strong> · To end of audio: <strong>${ms(s.toEnd)}</strong>${bars}</li>`;
+}
+
+function render(): void {
+  const turns = session.turns;
+  const label = (t: Turn, l: Lang) =>
+    `<span class="label">Turn ${t.seq + 1} · ${LANG[l]} · ${t.state}</span>`;
+  $("src").innerHTML = turns
+    .map(
+      (t) =>
+        `<li>${label(t, t.from)}${esc(t.srcText ?? "") || "…"}${t.error ? `<span class="err label">${esc(t.error)}</span>` : ""}</li>`,
+    )
+    .join("");
+  $("tgt").innerHTML = turns.map((t) => `<li>${label(t, t.to)}${targetLine(t)}</li>`).join("");
+  $("timing").innerHTML = turns.map(timingItem).join("");
+  startBtn.textContent = session.live ? "Stop" : "Start";
+  startBtn.disabled = micDenied || busy;
+  evalBtn.disabled = busy;
+  pairSel.disabled = session.live;
+}
+
+async function getMic(): Promise<MediaStream | null> {
+  try {
+    return await navigator.mediaDevices.getUserMedia({
+      audio: { echoCancellation: true, noiseSuppression: true, channelCount: 1 },
+    });
+  } catch (e) {
+    const denied = e instanceof DOMException && (e.name === "NotAllowedError" || e.name === "SecurityError");
+    if (denied) micDenied = true;
+    setStatus(
+      denied
+        ? "Microphone permission denied. Allow microphone access for this page in your browser settings, then reload."
+        : `Could not open the microphone: ${(e as Error).message}`,
+    );
+    render();
+    return null;
+  }
+}
+
+let mic: MediaStream | null = null;
+startBtn.addEventListener("click", async () => {
+  if (session.live) {
+    session.stop();
+    mic?.getTracks().forEach((t) => t.stop());
+    mic = null;
+    return setStatus("Stopped.");
+  }
+  mic = await getMic();
+  if (!mic) return;
+  setStatus("Connecting…");
+  try {
+    await session.start(mic);
+    setStatus("Listening. Speak in English or Spanish.");
+  } catch (e) {
+    setStatus(`Could not start: ${(e as Error).message}`);
+  }
+});
+
+document.querySelectorAll<HTMLInputElement>('input[name="mode"]').forEach((r) =>
+  r.addEventListener("change", async () => {
+    try {
+      await session.setMode(r.value as Mode);
+      if (session.live) setStatus(`Switched to ${r.value === "realtime" ? "voice-to-voice" : "cascade"}.`);
+    } catch (e) {
+      setStatus(`Could not switch mode: ${(e as Error).message}`);
+    }
+  }),
+);
+
+pairSel.addEventListener("change", () => (session.pair = pairSel.value.split("-") as [Lang, Lang]));
+headphones.addEventListener("change", () => session.setEchoGuard(!headphones.checked));
+
+evalBtn.addEventListener("click", async () => {
+  busy = true;
+  render();
+  try {
+    await runEval(session, vendors, setStatus);
+  } catch (e) {
+    setStatus(`Eval failed: ${(e as Error).message}`);
+  } finally {
+    busy = false;
+    render();
+  }
+});
+
+fetch("/api/config")
+  .then((r) => r.json() as Promise<Record<string, string>>)
+  .then((c) => {
+    vendors = c;
+    $("vendors").textContent = Object.entries(c)
+      .map(([k, v]) => `${k}: ${v}`)
+      .join(" · ");
+  })
+  .catch(() => ($("vendors").textContent = "Vendors unavailable (is the server running?)"));
+
+render();
diff --git a/src/client/player.ts b/src/client/player.ts
new file mode 100644
index 0000000..95ad5cb
--- /dev/null
+++ b/src/client/player.ts
@@ -0,0 +1,152 @@
+// Cascade playback (lld §5): plays turns in seq order, never waits on failed/empty turns, barge-in cuts,
+// and reports `playing` so the transport can mute mic frames while our own audio plays (echo guard, FR-020).
+import type { TurnState } from "../shared/contracts.ts";
+import { pcm16ToFloat } from "./lib.ts";
+
+const RATE = 24000;
+/** a turn with no live audio, no new chunk for this long, and later audio waiting, is treated as finished */
+const STALL_MS = 1500;
+
+interface Q {
+  pending: Int16Array[];
+  recorded: Int16Array[];
+  final: boolean;
+  started: boolean;
+  live: Set<AudioBufferSourceNode>;
+  lastChunkAt: number;
+}
+
+export interface PlayerEvents {
+  firstAudio(seq: number, t: number): void;
+  audioEnd(seq: number, t: number): void;
+  cut(seq: number): void;
+}
+
+export class Player {
+  readonly ctx = new AudioContext();
+  private out = this.ctx.createMediaStreamDestination();
+  private gain = this.ctx.createGain();
+  private queues = new Map<number, Q>();
+  private nextTime = 0;
+  private timer: ReturnType<typeof setTimeout> | undefined;
+
+  constructor(private ev: PlayerEvents) {
+    this.gain.connect(this.ctx.destination);
+    this.gain.connect(this.out);
+  }
+
+  get stream(): MediaStream {
+    return this.out.stream;
+  }
+
+  get playing(): boolean {
+    for (const q of this.queues.values()) if (q.live.size) return true;
+    return false;
+  }
+
+  push(seq: number, pcm: Int16Array): void {
+    const q = this.q(seq);
+    if (!q) return;
+    q.pending.push(pcm);
+    q.recorded.push(pcm);
+    q.lastChunkAt = performance.now();
+    this.pump();
+  }
+
+  setState(seq: number, state: TurnState): void {
+    if (state === "done" || state === "failed" || state === "empty" || state === "cut") {
+      const q = this.q(seq);
+      if (q) q.final = true;
+      if (state !== "done" && q) q.pending = []; // never play a failed/cut turn's leftovers late (INV-3)
+      this.pump();
+    } else this.q(seq);
+  }
+
+  /** a new turn's speech ended: cut everything older that is still queued or playing (D19) */
+  bargeIn(seq: number): void {
+    for (const [s, q] of this.queues) {
+      if (s >= seq || (!q.live.size && !q.pending.length)) continue;
+      q.live.forEach((src) => {
+        src.onended = null;
+        src.stop();
+      });
+      this.queues.delete(s);
+      this.done.add(s);
+      this.kept.set(s, q.recorded);
+      this.ev.cut(s);
+    }
+    this.nextTime = 0;
+    this.pump();
+  }
+
+  /** PCM16 24 kHz audio received for a turn (eval recording) */
+  recorded(seq: number): Int16Array[] {
+    return this.queues.get(seq)?.recorded ?? this.kept.get(seq) ?? [];
+  }
+
+  close(): void {
+    clearTimeout(this.timer);
+    void this.ctx.close();
+  }
+
+  private done = new Set<number>();
+  private kept = new Map<number, Int16Array[]>();
+
+  private q(seq: number): Q | undefined {
+    if (this.done.has(seq)) return undefined;
+    let q = this.queues.get(seq);
+    if (!q) {
+      q = { pending: [], recorded: [], final: false, started: false, live: new Set(), lastChunkAt: 0 };
+      this.queues.set(seq, q);
+    }
+    return q;
+  }
+
+  private finish(seq: number, q: Q): void {
+    this.queues.delete(seq);
+    this.done.add(seq);
+    this.kept.set(seq, q.recorded);
+    if (q.started) this.ev.audioEnd(seq, performance.now());
+  }
+
+  private pump(): void {
+    clearTimeout(this.timer);
+    for (;;) {
+      if (!this.queues.size) return;
+      const seq = Math.min(...this.queues.keys());
+      const q = this.queues.get(seq)!;
+      for (const pcm of q.pending) this.schedule(seq, q, pcm);
+      q.pending = [];
+      if (q.live.size) return;
+      const laterWaiting = [...this.queues].some(([s, o]) => s > seq && o.pending.length);
+      const stalled = laterWaiting && performance.now() - q.lastChunkAt > STALL_MS;
+      if (q.final || stalled) {
+        this.finish(seq, q);
+        continue;
+      }
+      if (laterWaiting) this.timer = setTimeout(() => this.pump(), STALL_MS);
+      return;
+    }
+  }
+
+  private schedule(seq: number, q: Q, pcm: Int16Array): void {
+    if (!pcm.length) return;
+    const buf = this.ctx.createBuffer(1, pcm.length, RATE);
+    buf.copyToChannel(pcm16ToFloat(pcm) as Float32Array<ArrayBuffer>, 0);
+    const src = this.ctx.createBufferSource();
+    src.buffer = buf;
+    src.connect(this.gain);
+    const at = Math.max(this.nextTime, this.ctx.currentTime + 0.02);
+    src.start(at);
+    this.nextTime = at + buf.duration;
+    q.live.add(src);
+    if (!q.started) {
+      q.started = true;
+      this.ev.firstAudio(seq, performance.now() + (at - this.ctx.currentTime) * 1000);
+    }
+    src.onended = () => {
+      q.live.delete(src);
+      this.pump();
+    };
+  }
+}
diff --git a/src/client/session.ts b/src/client/session.ts
new file mode 100644
index 0000000..1ed2876
--- /dev/null
+++ b/src/client/session.ts
@@ -0,0 +1,141 @@
+// Session store (lld §5): owns mode, pair and the conversation history; transports are swapped under it.
+import type { Lang, Mode, TimingPoint, TurnText, TurnUpdate } from "../shared/contracts.ts";
+import type { Timings } from "./lib.ts";
+
+export interface Turn extends TurnUpdate {
+  timings: Timings;
+  vendors: Partial<Record<TimingPoint, string>>;
+  error?: string;
+}
+
+export type TurnPatch = Partial<TurnUpdate> & { turnId: string };
+
+export interface TransportEvents {
+  turn(u: TurnPatch): void;
+  /** t is browser time (performance.now()) */
+  timing(turnId: string, point: TimingPoint, t: number, vendor?: string): void;
+  notice(msg: string): void;
+  /** turnId set when the error belongs to a turn; otherwise shown on the latest turn */
+  error(msg: string, turnId?: string): void;
+}
+
+export interface Transport {
+  start(input: MediaStream, context: TurnText[], pair: [Lang, Lang]): Promise<void>;
+  stop(): void;
+  /** interpreted audio as a stream (eval recording); null until available */
+  output(): MediaStream | null;
+  setEchoGuard(on: boolean): void;
+}
+
+export type TransportFactory = (mode: Mode, events: TransportEvents) => Transport;
+
+const TERMINAL = new Set(["done", "failed", "empty", "cut"]);
+export const isTerminal = (t: Turn) => TERMINAL.has(t.state);
+
+export class Session {
+  mode: Mode = "realtime";
+  pair: [Lang, Lang] = ["en", "es"];
+  turns: Turn[] = [];
+  live = false;
+  echoGuard = true;
+  private transport: Transport | null = null;
+  private input: MediaStream | null = null;
+  private gen = 0;
+
+  constructor(
+    private make: TransportFactory,
+    private onChange: (notice?: string) => void,
+  ) {}
+
+  /** last 5 interpreted turns, oldest first (INV-6, FR-029) */
+  context(): TurnText[] {
+    return this.turns
+      .filter((t) => t.srcText && t.tgtText)
+      .slice(-5)
+      .map((t) => ({ srcText: t.srcText!, tgtText: t.tgtText!, from: t.from, to: t.to }));
+  }
+
+  output(): MediaStream | null {
+    return this.transport?.output() ?? null;
+  }
+
+  async start(input: MediaStream): Promise<void> {
+    this.input = input;
+    this.live = true;
+    const gen = ++this.gen;
+    const mode = this.mode;
+    const key = (id: string) => `${gen}:${id}`;
+    const current = () => gen === this.gen;
+    const t = this.make(mode, {
+      turn: (u) => current() && this.upsert({ ...u, turnId: key(u.turnId) }, mode),
+      timing: (id, point, at, vendor) => {
+        if (!current()) return;
+        const turn = this.upsert({ turnId: key(id) }, mode);
+        turn.timings[point] = at;
+        if (vendor) turn.vendors[point] = vendor;
+        this.onChange();
+      },
+      notice: (msg) => current() && this.onChange(msg),
+      error: (msg, id) => {
+        if (!current()) return;
+        const turn = id ? this.upsert({ turnId: key(id) }, mode) : this.turns.at(-1);
+        if (turn) turn.error = msg;
+        this.onChange(msg);
+      },
+    });
+    this.transport = t;
+    t.setEchoGuard(this.echoGuard);
+    this.onChange();
+    try {
+      await t.start(input, this.context(), this.pair);
+    } catch (e) {
+      if (current()) this.stop();
+      throw e;
+    }
+  }
+
+  stop(): void {
+    this.gen++;
+    this.transport?.stop();
+    this.transport = null;
+    this.live = false;
+    this.onChange();
+  }
+
+  /** Mode is switchable before and during a session; mid-session the new transport gets the last 5 turns. */
+  async setMode(mode: Mode): Promise<void> {
+    if (mode === this.mode) return;
+    this.mode = mode;
+    if (!this.live || !this.input) return this.onChange();
+    const input = this.input;
+    this.stop();
+    await this.start(input);
+  }
+
+  setEchoGuard(on: boolean): void {
+    this.echoGuard = on;
+    this.transport?.setEchoGuard(on);
+  }
+
+  private upsert(u: TurnPatch, mode: Mode): Turn {
+    let turn = this.turns.find((t) => t.turnId === u.turnId);
+    if (!turn) {
+      turn = {
+        seq: this.turns.length,
+        mode,
+        state: "hearing",
+        from: this.pair[0],
+        to: this.pair[1],
+        timings: {},
+        vendors: {},
+        ...u,
+      } as Turn;
+      this.turns.push(turn);
+    } else {
+      for (const [k, v] of Object.entries(u))
+        if (v !== undefined) (turn as unknown as Record<string, unknown>)[k] = v;
+    }
+    this.onChange();
+    return turn;
+  }
+}
